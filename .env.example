# Copy to .env and fill in every value below. .env is gitignored.
# There are no defaults in code: a missing value raises immediately and names
# the variable, rather than silently using a wrong endpoint or metadata.

# Gateway credentials.
TFY_API_KEY=
TFY_BASE_URL=

# Metadata tagged onto every gateway request, for tracing and attribution.
# TFY_TEAM must be one of the values your gateway allows, or the
# mandatory-metadata guardrail rejects the request.
TFY_SERVICE=
TFY_TEAM=
ENV=
